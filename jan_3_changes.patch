+def prompt_type_cls(prompt):
+
+    if "list all possible answers for unfilled or changed words" in prompt:
+        prompt_type = "propose"
+    elif "Respond only Yes or No" in prompt:
+        prompt_type = "if_correct"
+    elif "Write a plan for the next time." in prompt:
