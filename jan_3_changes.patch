+def reranker_loss_1(ranks_gt, scores_pred, gap=1):
+    # 采用hinge的格式
+
+    total_loss = None
+    count = 0
+    bsz = len(ranks_gt)
+    acc = 0
+    var = 0
+    for i in range(bsz):
+        for j in range(bsz):
+            r_i = ranks_gt[i]
+            r_j = ranks_gt[j]
+            if r_j < r_i:
+                continue
+
+            coeff = max(0.0, r_j - r_i)
+
+            sp_i = scores_pred[i]
+            sp_j = scores_pred[j]
+            log_value = - torch.log(1 + sp_j - sp_i)
+
+            if total_loss is None:
+                total_loss = coeff ** 1.2 * log_value
+            else:
+                total_loss += coeff ** 1.2 * log_value
+
+            if sp_j >= sp_i:
+                acc += 1
+
+            count += 1
+
+    if count == 0:
+        loss = None
+        acc = 0.0
+        var_ = 0.0
+    else:
+        loss = total_loss / count
+        acc = acc / count
+
+        # 计算 variance
+        var_ = torch.std(scores_pred, dim=0, keepdim=False)
+        # print("score var_: ", var_)
+        # var_ = torch.clamp(var_, max=0.2)
+        #
+        # loss = loss - 0.5 * var_
+        if random.uniform(0, 1) < 0.01:
+            print("score var_: ", var_)
+
+    return loss, acc, var_
+
