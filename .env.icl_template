# ICL Retrieval System - Environment Configuration Template
# Copy this file to .env and fill in the values

# ============================================================
# REQUIRED VARIABLES
# ============================================================

# Path or name of the sentence transformer model for embeddings
# Examples: "BAAI/bge-base-en-v1.5", "/path/to/local/model"
EMBEDDING_MODEL_PATH="BAAI/bge-base-en-v1.5"

# Number of demos to retrieve from FAISS
# Recommended: 5-15
TOP_K=10

# Demo selection method
# Options: "fixed", "retrieved", "reranked"
# - fixed: Use pre-defined demos (requires populating existing_demos.py)
# - retrieved: Use FAISS similarity search (recommended to start)
# - reranked: Use FAISS + trained reranker (best performance, requires training)
demo_method="reranked"

# ============================================================
# OPTIONAL VARIABLES (for reranked mode)
# ============================================================

# Number of demos to keep after reranking (only used if demo_method="reranked")
# Should be less than TOP_K
# Recommended: 3-5
# TOP_K_2=3

# Path to trained reranker checkpoint (only used if demo_method="reranked")
# Example: "./reranker_output/demo_reranker_100"
# reranker_ckpt_path=""

# ============================================================
# OPTIONAL VARIABLES (advanced)
# ============================================================

# Whether to add additional cue hints to prompts
# Options: "true", "false"
# Default: "false"
add_direct_cues="false"

# ============================================================
# FOR RERANKER TRAINING ONLY
# ============================================================

# LLM model name for scoring demos during reranker training
# This is only needed when running run_reranker_ft.py
# Examples: "gpt-4", "gpt-3.5-turbo", etc.
# model_name="gpt-4"

# ============================================================
# NOTES
# ============================================================

# 1. Make sure to generate embeddings first:
#    python3 scripts/generate_embeddings.py --demo_dir /path/to/demos
#
# 2. Demo files should be in the format:
#    {"input": "...", "output": "..."}
#
# 3. For each demo file (e.g., list_demos_propose.json), you need:
#    - The JSON file with demos
#    - The corresponding .npy file with embeddings
#
# 4. File naming convention:
#    - list_demos_propose.json + list_demos_propose.npy
#    - list_demos_if_correct.json + list_demos_if_correct.npy
#    - list_demos_suggest.json + list_demos_suggest.npy
#    - list_demos_value.json + list_demos_value.npy
